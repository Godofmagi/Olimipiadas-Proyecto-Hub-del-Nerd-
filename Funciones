import mariadb
import customtkinter

def conectar():
    conexion = mariadb.connect(
    host="localhost",
    user="root",
    password="",
    database="Tienda_De_Comics"
)
    return conexion

def registrar_producto():
    conexion = conectar()
    cursor = conexion.cursor()
    codigo = int(input("Código: "))
    nombre = input("Nombre: ")
    categoria = input("Categoría: ")
    precio = float(input("Precio: "))
    stock = int(input("Stock: "))
    sql = """
        INSERT INTO productos
        (codigo, nombre, categoria, precio, stock)
        VALUES (?, ?, ?, ?, ?)
    """
    cursor.execute(
        sql,
        (codigo, nombre, categoria, precio, stock)
    )
    conexion.commit()
    cursor.close()
    conexion.close()
    print("Producto registrado correctamente.")

def mostrar_productos():
    conexion = conectar()
    cursor = conexion.cursor()
    cursor.execute("""
        SELECT codigo, nombre, categoria, precio, stock
        FROM productos
    """)
    
    productos = cursor.fetchall()
    
    print("\nLISTADO DE PRODUCTOS")
    print("-" * 60)
    
    for producto in productos:
        print(
            producto[0],
            producto[1],
            producto[2],
            "$", producto[3],
            "Stock:", producto[4]
        )
    cursor.close()
    conexion.close()

def buscar_producto():
    codigo = int(input("Ingrese el código a buscar: "))
    
    conexion = conectar()
    cursor = conexion.cursor()
    
    cursor.execute(
        "SELECT * FROM productos WHERE codigo = ?",
        (codigo,)
    )

    producto = cursor.fetchone()
    
    if producto:
        print("\nProducto encontrado")
        print("Código:", producto[0])
        print("Nombre:", producto[1])
        print("Categoría:", producto[2])
        print("Precio:", producto[3])
        print("Stock:", producto[4])
    else:
        print("El producto no existe.")
    cursor.close()
    conexion.close()
    
def modificar_producto():
    codigo = int(input("Código del producto: "))
    nuevo_precio = float(input("Nuevo precio: "))
    nuevo_stock = int(input("Nuevo stock: "))

    conexion = conectar()
    cursor = conexion.cursor()

    sql = """
        UPDATE productos
        SET precio = ?, stock = ?
        WHERE codigo = ?
    """
    
    cursor.execute(
        sql,
        (nuevo_precio, nuevo_stock, codigo)
    )

    conexion.commit()
    
    if cursor.rowcount > 0:
        print("Producto modificado.")
    else:
        print("No se encontró el producto.")
    cursor.close()
    conexion.close()

def eliminar_producto():
    codigo = int(input("Código del producto a eliminar: "))

    conexion = conectar()
    cursor = conexion.cursor()

    cursor.execute(
        "DELETE FROM productos WHERE codigo = ?",
        (codigo,)
    )
    conexion.commit()

    if cursor.rowcount > 0:
        print("Producto eliminado.")
    else:
        print("Producto inexistente.")
    cursor.close()
    conexion.close()
    
def ordenar_productos():
    conexion = conectar()
    cursor = conexion.cursor()

    cursor.execute("""
        SELECT codigo, nombre, categoria, precio, stock
        FROM productos
        ORDER BY precio ASC
    """)

    productos = cursor.fetchall()

    for producto in productos:
        print(producto)
    cursor.close()
    conexion.close()

def filtrar_productos():
    categoria = input("Ingrese la categoría: ")

    conexion = conectar()
    cursor = conexion.cursor()

    cursor.execute("""
        SELECT *
        FROM productos
        WHERE categoria = ?
    """, (categoria,))

    productos = cursor.fetchall()
    
    for producto in productos:
        print(producto)
    cursor.close()
    conexion.close()

def obtener_stock():
    conexion = conectar()
    cursor = conexion.cursor()

    cursor.execute("SELECT stock FROM productos")

    datos = cursor.fetchall()

    cursor.close()
    conexion.close()

    return datos

def sumar_stock(datos, posicion=0):
    if posicion == len(datos):
        return 0
    
    return datos[posicion][0] + sumar_stock(
        datos,
        posicion + 1
    )




def menu():
    while True:
        print("\n==============================")
        print(" MAXIKIOSCO")
        print("==============================")
        print("1 - Registrar producto")
        print("2 - Mostrar productos")
        print("3 - Buscar producto")
        print("4 - Modificar producto")
        print("5 - Eliminar producto")
        print("6 - Ordenar productos")
        print("7 - Filtrar productos")
        print("8 - Calcular stock total")
        print("0 - Salir")
        opcion = input("Seleccione una opción: ")
        if opcion == "1":
            registrar_producto()
        elif opcion == "2":
            mostrar_productos()
        elif opcion == "3":
            buscar_producto()
        elif opcion == "4":
            modificar_producto()
        elif opcion == "5":
            eliminar_producto()
        elif opcion == "6":
            ordenar_productos()
        elif opcion == "7":
            filtrar_productos()
        elif opcion == "8":
            datos = obtener_stock()
            total = sumar_stock(datos)
            print("Stock total:", total)
        elif opcion == "0":
            print("Programa finalizado.")
            break
        else:
            print("Opción incorrecta.")

menu()